# ============================================================================
# Dump Sniper V3 - Environment Variables
# ============================================================================
# v3 关键变化：去掉 Jupiter，直调 Pump.fun AMM (PumpSwap) via 官方 SDK
# 延迟从 v2 的 ~250ms (Jupiter HTTP) 降到 ~80ms (RPC + 本地构造)
# ============================================================================

# ============ Mode ============
# DRY_RUN=true 时不实际下单，仅记录信号和模拟执行
# 强烈建议先跑 24-48h DRY_RUN 验证策略胜率再切 LIVE
DRY_RUN=true

# ============ Strategy ============
# 触发条件 (v3.10: 加 max impact + 池子流动性下限，过滤伪砸盘和流动性死亡的池子)
#
# 实盘数据：之前 10/10 双 AND 抓到的多是边缘案例
#   - 大池子 10 SOL 卖单 → impact 5-9% → 没反弹空间
#   - 小池子 10 SOL 卖单 → impact 30%+ → 有反弹但流动性危险，进出滑点大
#   - 真正赚钱的：sell ≥ 15 SOL + impact 12-30% + 池子流动性 ≥ 30 SOL
#
# v3.17.8 实战权衡(用户在 11:27 把 MIN_SELL_SOL 调到 10, MIN_PRICE_IMPACT_PCT 调到 10):
#   降门槛的利:更多信号(从 30 个全被拒 → 至少一些能通过)
#   降门槛的弊:小砸单的反弹质量可能 < 大砸单(对手也是顶级 sniper 抢)
#   建议:跑 24-48 小时后用 npm run analyze 看
#         如果 10-14 SOL 砸单的 avg_pnl > 0 且 > 15+ SOL 砸单的 avg_pnl → 降是对的
#         如果 < 0 或显著低于 15+ SOL → 调回 15
MIN_SELL_SOL=10.0          # 决心卖单门槛 (v3.17.8 从 15 调到 10 测试)
MIN_PRICE_IMPACT_PCT=10.0  # 反弹下限 (v3.17.8 从 12 调到 10 测试)
MAX_PRICE_IMPACT_PCT=30.0  # 反弹上限 (>30% 通常池子已死)
MIN_POOL_QUOTE_SOL=30.0    # 池子最少 SOL 流动性 (微盘容易被卡)

# 仓位（先从小金额开始！v1 已经因为 bug 亏过钱）
POSITION_SIZE_SOL=0.1

# ============================================================================
# v3.17 止盈策略改造（重要！）
# ============================================================================
# 主止盈（双确认）：+50% 反弹才止盈，捕捉真正的大行情
# 旧值 +8% 太容易触发 → 滑点+fee 吃掉利润 → 平均亏损
TAKE_PROFIT_PCT=50.0
TP_CONFIRM_COUNT=2
TP_CONFIRM_MIN_GAP_MS=300

# 移动止盈（trailing stop）— v3.17.6 实战调参
#   1) 当 highWaterMark 涨过 entryPrice × (1 + TRAILING_ACTIVATE_PCT/100) 后激活 trailing
#   2) 激活后，价格从 highWaterMark 回撤 TRAILING_DRAWDOWN_PCT% 立即 SELL
#   3) TRAILING_MIN_HWM_AGE_MS：highWaterMark 必须稳定至少此毫秒数才允许触发
#      （防单 tick 价格污染创虚假高点，下一 tick "回撤"误卖）
# 设 TRAILING_ACTIVATE_PCT=0 或 TRAILING_DRAWDOWN_PCT=0 可禁用移动止盈
#
# v3.17.6 调参原因（实战6个bug驱动）：
#   - 旧 5%/2% 太敏感，被"AMM 自买入推高池子价格"误触发
#   - 单纯调到 15%/5% 又过于保守，错过中等反弹
#   - 真正的解：stabilization 期（见下方 STABILIZATION_MS）过滤瞬态高价 + 8%/3% 双保险
TRAILING_ACTIVATE_PCT=8.0
TRAILING_DRAWDOWN_PCT=3.0
TRAILING_MIN_HWM_AGE_MS=2000

# v3.17.6 Stabilization 期（毫秒）—— 砸盘后稳定缓冲
#   reconcile 完成后，等价格从砸盘瞬态波动 + AMM 自买入虚高中稳定下来再开始 trailing。
#   期间收集 priceTick → 取中位数作为 HWM baseline，过滤异常值。
#   emergency_stop（-15%）在 stabilization 期内仍然工作。
#   实测：5 秒覆盖多数砸盘后波动场景；太短保护不够，太长错过早期反弹入场。
STABILIZATION_MS=5000

# 紧急止损：跌幅 <= 此值立即出场（不双确认，救命路径）
# 设为 0 则禁用（恢复"硬扛到 maxHoldMs"行为）
EMERGENCY_STOP_LOSS_PCT=-15.0

# 最大持仓时间（毫秒）— v3.17: 从 15s 拉到 30min 给反弹更多时间
MAX_HOLD_MS=1800000

# v3.4: 持仓期间主动池子轮询间隔（毫秒）
# 修复 TIMEOUT 主导问题：微盘币 15s 内可能没有外部 swap 触发 PriceTracker，
# 导致价格永远是 entryPrice，永远不止盈也不止损，全部走到 TIMEOUT。
# 持仓期间每 X ms 主动拉每个 token 的 pool state 算实时价。
# 500ms 默认值：15s 持仓 = 30 次轮询 = 30 次 RPC，对 Helius Business 配额无压力。
# 想更激进降到 250ms（60 次/持仓）；想省配额升到 1000ms。
POOL_POLL_INTERVAL_MS=500

# v3.14 滚动式后台 pool state 刷新
# 每个 token 被刷新一次的周期。70 token + 5s = 平均 14 RPS（无爆发）
# 实测 swapSolanaState 内部可能拉多个账户，实际 RPS 可达 2-4 倍
# Helius Business 限 50 RPS，70 token × 4 acct / 5s = 56 RPS → 调到 5s 仍危险
# 推荐：监控 ≤ 50 token 用 3000ms；50-100 token 用 5000ms；100+ token 用 8000ms
POOL_STATE_REFRESH_MS=5000

# v3.14 滚动刷新的 tick 间隔
# 把 N 个 token 均匀分摊到这个 tick 频率上，避免瞬时 RPS 爆发
# 默认 200ms = 每秒 5 次小批量；每批刷 N × tick/refresh 个 token
# 不需要调，保持默认
POOL_STATE_TICK_MS=200

# 滑点（bps，10000 = 100%）
# Pump SDK 接受 percent (1500 bps = 15%)，注意单位
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2000

# 风控
COOLDOWN_MS_PER_TOKEN=60000
# v3.17: 最大同时持仓 5（旧 3）
MAX_CONCURRENT_POSITIONS=5

# v3.17.6: 同砸单去重时间窗（毫秒）
#   防 LaserStream 多 region 跨越 dedup TTL（5min）后重推同一砸单导致二次触发买入。
#   实战案例：同一 seller_tx 2 分钟后被慢 region 重新推送 → mint 冷却已过 → 二次 BUY
#             但价格已经跌 20%，根本不是反弹窗口 → 直接亏 0.15 SOL
#   持久化：写入 signals 表 accepted=1 行，启动时从 DB 恢复（重启不丢）
#   10 分钟覆盖最慢 region + 重启窗口
SELLER_TX_DEDUP_MS=600000

# v3.17.7: 同卖家+同代币 去重窗(毫秒)
#   防"持续出货"场景反复触发买入。实战案例:
#     同一卖家 ikG8tz5e 18 秒内对 POSITIONS 砸了 2 次(seller_tx 不同),
#     2 次都被买入 2 次都亏 — 这说明卖家在持续出货,不是恐慌抛售
#   注意:这跟 SELLER_TX_DEDUP_MS 不同:
#     - SELLER_TX_DEDUP_MS:同一笔砸单 tx 被重推(LaserStream 多 region 跨 TTL)
#     - SELLER_MINT_DEDUP_MS:同一卖家不同砸单 tx 砸同一代币
#   设 0 禁用此检查
SELLER_MINT_DEDUP_MS=600000

# v3.17.7: 信号过期 slot gap 阈值
#   砸盘 slot 与当前最新 slot 差超过此值就丢弃信号
#   实战:某些代币 LaserStream 推送延迟 48-88 秒(127-214 slot),
#         那时候反弹早结束,买在山顶 → emergency_stop 出场
#   20 slot ≈ 8 秒延迟(Solana ~400ms/slot)
#   设 0 禁用
MAX_SIGNAL_SLOT_GAP=20

# v3.17.7: stabilization 期内 emergency_stop 阈值(从样本峰值回撤的 %)
#   stabilization 期内"相对 entryPrice 的 PnL"不可靠(自买入推高+回归造成假信号)
#   所以期间改用"相对样本最高价的回撤"判断:
#     - max(samples) ≈ 自买入推高的池子价格峰值
#     - 从峰值真的跌此 % 才认作灾难
#   20% 既能放过"自买入回归"(通常 ≤ 10-12%),又能抓真的暴跌
#   设 0 禁用(极端 dangerous,不推荐)
STABILIZATION_EMERGENCY_DRAWDOWN_PCT=20.0

# ============ Price Anomaly Filter ============
# 单 tick 价格变化超过 ±maxJumpRatio 视为可疑，需要双确认
# 1.5 = ±50% 跳变（实际 +50% 或 -33% 以上）
PRICE_MAX_JUMP_RATIO=1.5
PRICE_CONFIRM_WINDOW_MS=3000
PRICE_CONFIRM_MIN_SAMPLES=2

# ============ Helius ============
# v3.15 RPC 通道分流（关键！避免一个 endpoint 被打爆）
#   - HELIUS_RPC_URL：普通公共节点，用于 PoolStateCache 后台刷新 + 查询类调用
#     【建议用标准共享端点】https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#     ⚠️ 不要用专属/Secure 端点（如 donetta-1niumo-fast-...），专属节点限流严格，
#        70 个 token 滚动刷新会打爆它（实测每分钟数百 429）
#   - HELIUS_STAKED_RPC_URL：staked 端点，**仅用于 sendTransaction**
#     Business 计划的主 URL 就是 staked，可填同一个 URL
#   - HELIUS_SENDER_ENDPOINT：Helius Sender 服务（带 Jito 通道，强烈推荐）
HELIUS_API_KEY=your_helius_api_key_here

# 普通 RPC（用于 PoolStateCache 后台刷新 + 查询）
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Staked sendTransaction endpoint — 仅用于 sendTransaction，**不参与 PoolStateCache**
# Business 计划主 URL 自动就是 staked，跟 HELIUS_RPC_URL 填一样即可
HELIUS_STAKED_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# v3.13 / v3.16 Helius Sender — 强烈推荐启用（仅 BUY 走，SELL 自动绕过）
# Sender = 同时投递到 validator (SWQoS) + Jito 拍卖，双通道命中率更高
#
# ⚠️ Endpoint 选择（实测踩过的坑）：
#   - 优先用全局域名 https://sender.helius-rpc.com/fast（走 Cloudflare，最稳）
#   - 区域前缀 fra-sender / slc-sender 等 是裸 IP (64.130.x.x)
#     某些云服务器（如部分阿里云、Tencent Cloud）会拒绝这些裸 IP（Connection refused）
#   - 如果你服务器能直连裸 IP，区域端点延迟更低 5-10ms（值得测试）
#
# 7 个区域 endpoints:
#   法兰克福: http://fra-sender.helius-rpc.com/fast
#   阿姆斯特丹: http://ams-sender.helius-rpc.com/fast
#   东京: http://tyo-sender.helius-rpc.com/fast
#   新加坡: http://sg-sender.helius-rpc.com/fast
#   伦敦: http://lon-sender.helius-rpc.com/fast
#   纽约: http://ewr-sender.helius-rpc.com/fast
#   盐湖城: http://slc-sender.helius-rpc.com/fast
#
# 留空 → 只用 staked RPC（BUY 错过 Jito 通道）
# v3.16: SELL 不走 Sender（SELL tx 不带 tip 会被 Sender 拒收 → 浪费 500-700ms）
HELIUS_SENDER_ENDPOINT=https://sender.helius-rpc.com/fast

# ────────────────────────────────────────────────────────────────────────────
# v3.17 多 region Sender（推荐！同 slot 命中率明显提升）
# ────────────────────────────────────────────────────────────────────────────
# 砸单方的 leader 不一定在你的 region — 单一 region Sender 时 BUY 跨洋损 200-300ms。
# 配多个 region endpoint（逗号分隔，无空格），Executor 用 Promise.race 并发提交，
# 最快返回的赢，其它请求作废。Solana 节点基于 signature 去重，不会重复落链。
#
# 推荐配置（覆盖欧/美/亚）：
# HELIUS_SENDER_ENDPOINTS=http://fra-sender.helius-rpc.com/fast,http://ewr-sender.helius-rpc.com/fast,http://tyo-sender.helius-rpc.com/fast
#
# 注意：HELIUS_SENDER_ENDPOINTS 优先于 HELIUS_SENDER_ENDPOINT；两个都不配则不走 Sender
HELIUS_SENDER_ENDPOINTS=

# v3.17.8 Jito tip (lamports) - 实战调优:从 0.02 SOL 降到 0.003 SOL
# 实战发现(BABYTROLL slot 数据):
#   排名1 93kgxYKe: 无 Jito tip, priority fee 0.037 SOL, CU 111K → μL/CU 334M
#   排名2 3fZftz6m: 无 Jito tip, priority fee 0.012 SOL, CU 110K → μL/CU 113M
#   旧版我们: tip 0.02 + fee 0.01 + CU 163K → μL/CU 61M(第4名)
# 核心:Solana leader 同 slot 排序看 μL/CU = priority_fee / CU,**Jito tip 不算入此公式**
# 顶级 sniper 都不用 tip,纯靠高 priority fee + 低 CU 取胜
#
# 保留 0.003 SOL 兜底:Helius Sender 走 Jito 通道需要 tip ≥ 0.001 SOL
#   不配 → 只走 staked validator 通道,错过 Jito 单 tx 拍卖
#   配低 → 双通道(staked + Jito 拍卖),0.003 = 微小成本但保留 Jito 通道资格
# Helius Sender 官方最低 0.0002 SOL = 200_000 lamports
JITO_TIP_LAMPORTS=3000000

# LaserStream gRPC (用于实时交易订阅)
# ⚠️ 选择离服务器最近的端点：
#   法兰克福: https://laserstream-mainnet-fra.helius-rpc.com  (推荐欧洲服务器)
#   阿姆斯特丹: https://laserstream-mainnet-ams.helius-rpc.com
#   东京: https://laserstream-mainnet-tyo.helius-rpc.com
#   新加坡: https://laserstream-mainnet-sgp.helius-rpc.com
#   纽约: https://laserstream-mainnet-ewr.helius-rpc.com
#   匹兹堡: https://laserstream-mainnet-pitt.helius-rpc.com
#   盐湖城: https://laserstream-mainnet-slc.helius-rpc.com
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-fra.helius-rpc.com

# ────────────────────────────────────────────────────────────────────────────
# v3.17 多 region LaserStream（推荐！把 1.2-1.8s 尾延迟压平）
# ────────────────────────────────────────────────────────────────────────────
# 实测 LaserStream 推送 116ms ~ 1528ms（13x 差异），尾延迟来自"砸单 leader 离你 region 远"。
# 多 region 订阅同时连多个 endpoint，谁先收到 tx 就触发，signature 去重防重复处理。
#
# 推荐配置（欧+美+亚）：
# HELIUS_LASERSTREAM_ENDPOINTS=https://laserstream-mainnet-fra.helius-rpc.com,https://laserstream-mainnet-ewr.helius-rpc.com,https://laserstream-mainnet-tyo.helius-rpc.com
#
# 注意：流量 credits 会按 region 数翻倍（每个 region 各自跑订阅）
#       HELIUS_LASERSTREAM_ENDPOINTS 优先于 HELIUS_LASERSTREAM_ENDPOINT
HELIUS_LASERSTREAM_ENDPOINTS=

HELIUS_LASERSTREAM_TOKEN=your_laserstream_token_here

# ============ Pump AMM (v3: 直调，无第三方聚合器) ============
# Compute unit limit — 必须够覆盖 buy/sell 主指令 + 内部 fee_program CPI
COMPUTE_UNIT_LIMIT=250000
# v3.4 设 150K:实测成功 swap 消耗 135K-146K CU,余量仅 4K-14K
# v3.9 改 200K:HERMES 等带 fee_program CPI 的 swap 会超 150K → ProgramFailedToComplete
# v3.17.6 改 170K:实战发现 200K 余量 25% 浪费了 μL/CU 排名
# v3.17.8 改 111K:对标 BABYTROLL 排名1对手 → μL/CU 360M
# v3.17.9 改 250K:openclaw 实战 5 笔 BUY_CHAIN_FAILED,真实数据揭示:
#   Pump swap CU 消耗有很大方差,最低 137K,典型 140-145K,有时 ≥170K(看池子状态)
#   BABYTROLL slot 那次 93kgxYKe 用 111K 成功只是巧合,不能照搬到所有 swap
#   5 笔失败 = 0.2 SOL fee 白花,远比"CU 给太大导致 μL/CU 下降"代价高
#
# ⚠️ 关键性能因素:Solana leader 排序看 microLamports/CU = priority_fee / CU
#    CU 越小 → 同样 fee 下单价越高 → slot 内排名越靠前
#    但 CU 太小有风险:某些 swap 实际消耗 ≥ 配置值 → ProgramFailedToComplete
#                     token 卡钱包 / fee 白烧
#
# ⚠️ 监控:dashboard 看 PositionManager.cuNearLimit + buyChainFail 计数
#    一旦 cuNearLimit > 0,立刻把 COMPUTE_UNIT_LIMIT 再加 30K(到 280K)
#    一旦 buyChainFail > 0,立刻 +50K (到 300K),且查看是哪个代币(可能含 fee_program CPI)

# ============ Priority fees (v3.1+: BUY 高 fee 抢入，SELL 低 fee 节省成本) ============
# 实测竞争者钱包：BUY 0.012-0.045 SOL，SELL <0.0001-0.003 SOL
#
# 动态模式（推荐）：用 Helius getPriorityFeeEstimate 实时查询 mempool 拥堵
# 砸盘事件中整网 fee 飙升，自动跟上竞争者；非事件时段省 fee
PRIORITY_FEE_DYNAMIC=true

# 动态模式下 BUY/SELL 用哪个 percentile 级别
# 可选: min, low, medium (50%), high (75%), veryHigh (95%), unsafeMax
# BUY 用 veryHigh（砸盘抢入，整网最高 5% 的 fee），SELL 用 medium 即可
BUY_PRIORITY_LEVEL=veryHigh
SELL_PRIORITY_LEVEL=medium

# 动态模式的下限（防止 RPC 返回 0 或过低，导致进不了 leader）
# v3.17.9 调优:配合 CU 250K,priority fee 拉到 0.067 SOL 维持 μL/CU = 267M
#   v3.17.8: fee 0.04 / CU 111K = 360M μL/CU
#   v3.17.9: fee 0.067 / CU 250K = 267M μL/CU(略低于 BABYTROLL 排名1的 334M 但避免 BUY 爆)
#   每笔多花 0.027 SOL fee 但避免 BUY_CHAIN_FAILED 白烧 fee,ROI 明显更好
BUY_MIN_PRIORITY_FEE_LAMPORTS=67000000   # 0.067 SOL
SELL_MIN_PRIORITY_FEE_LAMPORTS=100000    # 0.0001 SOL

# 动态模式的上限（防止 RPC 异常返回天文数字烧钱）
# v3.11 ⚠️ 关键修复：之前 0.05 SOL cap 把单价卡死在 250K μL/CU
#         实测 FYX5 用 40M μL/CU、3fZftz6m 用 72M μL/CU
#         leader 排序看的就是 μL/CU，cap 太低导致同 slot 内排到后面
#         改 0.2 SOL = 真正能让 dynamic veryHigh 生效（μL/CU 上限到 1M）
#         砸盘事件下整网拥堵时这才是合理上限
BUY_CAP_PRIORITY_FEE_LAMPORTS=200000000  # 0.2 SOL
SELL_CAP_PRIORITY_FEE_LAMPORTS=2000000   # 0.002 SOL

# 静态模式 fallback（PRIORITY_FEE_DYNAMIC=false 或 RPC 失败时使用）
BUY_MAX_PRIORITY_FEE_LAMPORTS=20000000   # 0.02 SOL
SELL_MAX_PRIORITY_FEE_LAMPORTS=500000    # 0.0005 SOL

# 旧的统一字段（向后兼容，新部署可忽略）
MAX_PRIORITY_FEE_LAMPORTS=5000000

# ============ Birdeye ============
BIRDEYE_API_KEY=your_birdeye_key_here

# ============ Wallet ============
# 交易钱包私钥 (base58 编码)。仅 LIVE 模式需要
WALLET_PRIVATE_KEY_BS58=

# ============ Server ============
DASHBOARD_PORT=3001
# 监听网卡：0.0.0.0 = 全部，127.0.0.1 = 仅本地（用 SSH tunnel 时推荐）
BIND_HOST=0.0.0.0
# 可选：webhook 共享密钥
WEBHOOK_SECRET=
# 可选：dashboard 访问令牌（建议 LIVE 时启用）
# 生成: openssl rand -hex 32
DASHBOARD_TOKEN=

# ============ Misc ============
# 启动时是否后台自动补缺失的 pool 信息
AUTO_FILL_POOLS_ON_START=true

# v3.17: Priority fee oracle 后台刷新间隔（毫秒）
# 后台轮询不阻塞 BUY 路径，砸盘瞬间整网 fee 飙升 → 缩短刷新让动态 fee 跟得上
# 默认 500ms（旧 1500ms 跟不上砸盘瞬间）；想极致省 credit 拉到 1000-2000ms
PRIORITY_FEE_REFRESH_MS=500

# ============ v3.18 Jito Atomic Bundle 模式 ============
# 启用 atomic bundle 模式: BUY 跟砸盘 tx 同 slot 落链 (跟 hnu5/3fZftz6m/MRiY 同档位)
#
# 完整启用前置条件:
#   1. USE_BUNDLE_MODE=true (本变量)
#   2. 早信号源 (ShredStream/Helius Shred Delivery/Triton Deshred) 配置完成
#      — Week 2 才会接入数据源,在此之前 bundle 路径只是"待用"
#   3. JITO_TIP_LAMPORTS >= 1000 (Jito Bundle 强制 tip,通常 0.001-0.01 SOL)
#
# 不满足条件时,即使 USE_BUNDLE_MODE=true 也会自动走普通 BUY 路径 (完全向后兼容)
USE_BUNDLE_MODE=false

# Jito Bundle tip 百分位 (基于 Jito tip floor API)
# 可选: p25 / p50 / p75 / p95 / p99 / ema50
# 建议: p75 (进 top 25% bundle 拍卖,平衡成功率和成本)
#       高频赛道用 p95 (top 5%) 但成本翻 30 倍
BUNDLE_TIP_PERCENTILE=p75

# 在 percentile 基础上的安全系数
# 1.5 = 比 p75 高 50%, 防止 floor 短暂飙升时被挤掉
BUNDLE_TIP_BUFFER=1.5

# Jito Block Engine regions, 逗号分隔, 多 region 会并发提交取最快
# 可选: global / frankfurt / amsterdam / ny / tokyo / slc
# 你服务器在 FRA → 建议: global,frankfurt
# 服务器在 US East → 建议: global,ny
JITO_BUNDLE_REGIONS=global,frankfurt

# Bundle tip 上限 (lamports), 防止 tip floor 抽风导致烧钱
# 默认 0.02 SOL (20_000_000 lamports), 单笔 tip 超此值会被截断
BUNDLE_TIP_MAX_LAMPORTS=20000000

# Bundle 失败时是否 fallback 到普通 BUY
# 默认 false: bundle 失败就放弃这次砸盘 (避免 +1 slot 接顶级玩家的盘)
# true: fallback 到普通 BUY (回退到当前模式,胜率低但能接到)
BUNDLE_FALLBACK_TO_NORMAL=false

# ============ v3.18 Week 2: ShredStream.com 数据源 ============
# 启用 ShredStream.com SDK 订阅 (跟 USE_BUNDLE_MODE 配合使用)
#
# 这是 ShredStream.com (https://www.shredstream.com/), 不是 Jito 官方 ShredStream:
#   - 不需要本地 docker proxy
#   - npm install shredstream 后 SDK 直接 UDP 接收 + deshred + 输出 wire tx
#   - 在他们的 dashboard 配你服务器公网 IP + UDP port,他们推 shreds 给你
#
# 前置条件:
#   1. 在 https://www.shredstream.com/ 注册账户 + 启动 Shred Stream
#   2. dashboard 输入服务器公网 IP + UDP 端口 (要跟 SHREDSTREAM_PORT 一致)
#   3. 服务器防火墙 allow 入站 UDP (该端口)
#   4. 服务器 sysctl 调大 socket buffer:
#        sudo sysctl -w net.core.rmem_max=67108864
#        sudo sysctl -w net.core.busy_read=200
#   5. 在 sniper bot 目录: npm install shredstream
#      (Rust napi-rs 原生模块, Node.js 18+)
SHREDSTREAM_ENABLED=false

# ShredStream UDP 端口 (跟 ShredStream.com dashboard 里配的一致)
# 默认 8001
SHREDSTREAM_PORT=8001

# Socket recv buffer 字节数 (默认 64 MB, 须 ≤ sysctl net.core.rmem_max)
SHREDSTREAM_RECV_BUF_BYTES=67108864

# ShredStream SDK busy poll 微秒数 (Linux SO_BUSY_POLL)
#   - 高 (200-500) = 低延迟,但持续轮询吃 CPU
#   - 低 (50-100) = 省 CPU,偶尔多 50-100us 延迟
# 推荐:
#   - 4+ 核机器: 200 (默认)
#   - 2 核机器: 100 (减轻 CPU 压力)
SHREDSTREAM_BUSY_POLL_US=200

# Pump AMM program ID (用于 ShredStreamSource 过滤,只关心 Pump AMM tx)
# 默认值 = Pump AMM 主网 program ID,通常不需要改
PUMP_AMM_PROGRAM_ID=pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA

# ============ v3.18 Week 3: SsSwapDetector — SS 路径砸盘检测 ============
# 解决 Jito Bundle "transaction already processed" 400 错误问题
#
# 启用前提:
#   1. SHREDSTREAM_ENABLED=true (前置数据源)
#   2. USE_BUNDLE_MODE=true (输出 Jito Bundle)
#
# 工作原理:
#   SS 收到 raw tx → byte scan → deserialize → 找 sell discriminator
#   → 解 instruction data 拿 amount_in → 从 PoolStateCache 算 SOL 价值 + impact
#   → 通过阈值则 emit dumpSignal (含 dumpTxRaw)
#   → SignalEngine → Executor.buyBundle (跟 dump tx 同 slot)
#
# vs LS 路径:
#   - LS 路径: 等 dump tx confirmed 才能解析 (慢 ~400-700ms, 必然 +1 slot)
#   - SS 路径: 不等 confirm, 直接从 raw tx 解析 (~50-100ms, 同 slot)
#
# 双触发防护:
#   - SsSwapDetector 内部 sig dedup
#   - DumpDetector 检查 ssSwapDetector.hasProcessed(sig), 已处理则跳过 LS 触发
#
# 风险:
#   - SS 路径拿不到 meta, 部分边缘情况 (Jupiter 路由等 pool 在 ALT 里的 tx) 会被跳过
#   - LS 路径仍兜底, 这些 tx 走旧路径 (+1 slot, 不是同 slot 但还能接到)
SS_SWAP_DETECTOR_ENABLED=false
